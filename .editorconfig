# Impostazioni comuni degli editor, allineate a Prettier (.prettierrc.json).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# In Markdown due spazi in fondo alla riga vanno a capo: non si tolgono.
trim_trailing_whitespace = false
