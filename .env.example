# Variabili d'ambiente del backend: solo le chiavi, nessun valore segreto (README, "Variabili
# d'ambiente"). Copia in `.env` per lo sviluppo locale; in produzione i segreti arrivano da
# Secret Manager. I segreti devono avere almeno 32 caratteri.

# Servizio: app | admin | realtime
NODE_ENV=development
SERVICE_ROLE=app
PORT=
LOG_LEVEL=info
APP_TIMEZONE=Europe/Rome

# Database (PostgreSQL 17 locale con Homebrew, socket in /tmp)
DATABASE_URL=postgres:///swipe_slide_dev?host=/tmp
DATABASE_URL_DIRECT=
# Ruolo del database impostato a ogni connessione: app_role per app, backoffice_role per admin
DATABASE_ROLE=

# Redis (tempo reale, cache L2 e limiti di frequenza), obbligatorio (D229, D240)
REDIS_URL=redis://localhost:6379

# Autenticazione
JWT_ACCESS_SIGNING_KEY=
JWT_ADMIN_SIGNING_KEY=
HMAC_SECRET=
HMAC_SECRET_VERSION=v1
TOKEN_ENCRYPTION_KEY=

# Apple (bundle iOS e Services ID del flusso web su Android)
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=it.swipeandslide.app
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Indirizzo dell'app per il ritorno del flusso web di Apple (vuota = swipeandslide://auth/apple)
APPLE_WEB_RETURN_URL=

# Google (client ID del server, iOS e Android)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Operatori del backoffice
# Cloudflare Access davanti ad admin-api (D241); CF_ACCESS_DISABLED=true solo in sviluppo
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_DISABLED=true

# Email (D240): smtp (Mailpit in locale su localhost:1025, Brevo SMTP in produzione) | brevo (API)
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
EMAIL_FROM_NEUTRAL=
EMAIL_FROM_PROJECT=

# Archivio S3 di foto ed esportazioni (D240): MinIO in locale, Cloudflare R2 in produzione
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=swipe-slide
S3_FORCE_PATH_STYLE=true
# Controllo delle foto (D73): senza credenziali le foto vanno solo in revisione manuale
GOOGLE_APPLICATION_CREDENTIALS=
VISION_API_ENDPOINT=eu-vision.googleapis.com
# Origini del sito statico ammesse dal CORS sulle sole rotte /web-deletion/*
CORS_ALLOWED_ORIGINS=
# Solo sviluppo: origini dell'app web (export di Expo) ammesse su tutte le rotte di app-api, mai *;
# vuota = http://localhost:8081, :8082, :8090. In produzione non è ammessa.
CORS_DEV_ORIGINS=

# Osservabilità
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Custodia della chiave principale dei messaggi (D183, D241): env = chiave da MESSAGE_MASTER_KEY
# (almeno 32 caratteri, solo in .env locale); openbao = OpenBao con il motore transit
KEY_CUSTODY=env
MESSAGE_MASTER_KEY=
OPENBAO_ADDR=
OPENBAO_TOKEN=
OPENBAO_TRANSIT_KEY=

# Notifiche push con Expo Push (D65): token di accesso facoltativo
EXPO_ACCESS_TOKEN=

# Identificativo dell'istanza di realtime (facoltativo)
REALTIME_INSTANCE_ID=

# Indirizzo della pagina dei ricorsi nelle email delle sanzioni (D75)
APPEAL_URL=

# Casella del team per gli avvisi con i soli conteggi (approvazioni, moderazione, processi)
TEAM_ALERT_EMAIL=
