    "/cities": {
      "get": {
        "operationId": "DirectoryController_cities",
        "parameters": [
          {
            "description": "Prefisso del nome, almeno 2 caratteri",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CityDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "directory"
        ]
      }
    },
    "/companies": {
