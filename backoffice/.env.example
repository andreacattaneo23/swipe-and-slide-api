# Variabili d'ambiente del backoffice: solo le chiavi, nessun valore segreto.
# Copia in .env.local per lo sviluppo; in produzione i valori vengono da Secret Manager.

# URL di admin-api. In sviluppo, se manca, http://localhost:3001 (D238, D240); in produzione è
# obbligatoria (servizio Cloud Run privato).
ADMIN_API_URL=
# true su Cloud Run: il chiamante si presenta ad admin-api con il token d'identità del suo account
# di servizio (server dei metadati).
ADMIN_API_IAM=

# Chiave dei cookie cifrati, 32 byte in base64 (openssl rand -base64 32). Obbligatoria in
# produzione; in sviluppo, se manca, se ne crea una casuale e le sessioni finiscono al riavvio.
SESSION_SECRET=
# Cookie Secure e prefisso __Host-: di base attivi in produzione e spenti in sviluppo.
COOKIE_SECURE=

# Origine delle foto (URL firmati dell'archivio: MinIO in locale, R2 in produzione), aggiunta alla
# CSP img-src, per esempio http://127.0.0.1:9100.
ADMIN_PHOTOS_ORIGIN=

# Solo per i test end to end (npm run test:e2e) contro admin-api vera e Mailpit: operatore del
# seed del backend (di base admin@backoffice.example), che accede con il codice letto da Mailpit.
E2E_OPERATOR_EMAIL=
# API di Mailpit, di base http://localhost:8025.
E2E_MAILPIT_URL=
# Porta del backoffice avviato dai test (di base 3110, per non toccare il dev sulla 3100).
E2E_PORT=
