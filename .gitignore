# Le cartelle generate sono ancorate con "/" alla radice: senza, la regola varrebbe in ogni
# sottocartella e potrebbe nascondere codice vero (es. una cartella src/app/coverage/).

# Dipendenze
node_modules/

# Build e risultati dei test del backend
/dist/
/coverage/
*.tsbuildinfo

# Artefatti di Playwright e degli strumenti di test (D245)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Variabili d'ambiente e segreti: solo .env.example entra nel repository
.env
.env.*
!.env.example
*.pem
*.p8

# Log
/logs/
npm-debug.log*

# Editor e sistema
.DS_Store
.idea/
/.vscode/*
!/.vscode/extensions.json
*.swp

# Cache locali degli strumenti
.eslintcache
