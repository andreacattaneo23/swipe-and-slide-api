{
  "name": "swipe-and-slide-backend",
  "version": "0.0.0",
  "private": true,
  "description": "API NestJS di Swipe & Slide: regola core, accesso, registrazione e amministrazione",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "dev": "npm run start:dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:core-rule": "jest --selectProjects core-rule --runInBand",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/cli/migrate.js",
    "db:seed": "npm run build && node --env-file-if-exists=.env dist/cli/seed.js",
    "openapi": "npm run build && node dist/cli/openapi.js",
    "openapi:check": "npm run build && node dist/cli/openapi.js --check",
    "jobs": "node --env-file-if-exists=.env dist/jobs.js",
    "storage:setup": "npm run build && node --env-file-if-exists=.env dist/cli/storage-setup.js",
    "load:realtime": "node --env-file-if-exists=.env scripts/realtime-load.mjs",
    "texts:push": "node scripts/push-texts.mjs",
    "texts:push:check": "node scripts/push-texts.mjs --check",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "dev:stack": "node scripts/dev-stack.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@google-cloud/vision": "^6.2.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-ws": "^12.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "expo-server-sdk": "^7.2.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
