    "/registration/birth-date": {
      "put": {
        "operationId": "RegistrationController_birthDate",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BirthDateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationStateDto"
                }
              }
            },
            "description": ""
          }
        },
