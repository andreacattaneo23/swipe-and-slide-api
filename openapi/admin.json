{
  "components": {
    "schemas": {
      "AddDomainDto": {
        "properties": {
          "domain": {
            "example": "it.modello-partners.com",
            "type": "string"
          },
          "explanation": {
            "example": "Nuova società di consulenza approvata dal team",
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "explanation",
          "domain"
        ],
        "type": "object"
      },
      "CompanyDto": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "domains": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "isDemo": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "merged",
              "removing"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "isDemo",
          "domains",
          "createdAt"
        ],
        "type": "object"
      },
      "CreateCompanyDto": {
        "properties": {
          "domains": {
            "description": "Corrispondenza esatta (P12)",
            "example": [
              "modello-partners.it"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "explanation": {
            "example": "Nuova società di consulenza approvata dal team",
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          },
          "isDemo": {
            "default": false,
            "description": "Azienda dimostrativa per gli store (D42), immutabile",
            "type": "boolean"
          },
          "name": {
            "maxLength": 120,
            "type": "string"
          }
        },
        "required": [
          "explanation",
          "name",
          "domains"
        ],
        "type": "object"
      },
      "CreateOffsiteDto": {
        "properties": {
          "capacity": {
            "minimum": 1,
            "nullable": true,
            "type": "object"
          },
          "cityId": {
            "example": "015146",
            "type": "string"
          },
          "description": {
            "maxLength": 4000,
            "type": "string"
          },
          "endsAt": {
            "format": "date-time",
            "type": "string"
          },
          "explanation": {
            "example": "Nuova società di consulenza approvata dal team",
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          },
          "isDemo": {
            "default": false,
            "description": "Offsite dimostrativo (D42), immutabile",
            "type": "boolean"
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "type": "string"
          },
          "venueAddress": {
            "maxLength": 240,
            "type": "string"
          },
          "venueName": {
            "maxLength": 120,
            "type": "string"
          }
        },
        "required": [
          "explanation",
          "title",
          "description",
          "venueName",
          "venueAddress",
          "cityId",
          "startsAt",
          "endsAt"
        ],
        "type": "object"
      },
      "ExplanationDto": {
        "properties": {
          "explanation": {
            "example": "Nuova società di consulenza approvata dal team",
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "explanation"
        ],
        "type": "object"
      },
      "HealthDto": {
        "properties": {
          "status": {
            "example": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "OffsiteDto": {
        "properties": {
          "attendeesRounded": {
            "description": "Iscritti arrotondati: 0 = \"meno di 10\", poi la decina per difetto (D167)",
            "type": "number"
          },
          "cancelledAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "capacity": {
            "nullable": true,
            "type": "number"
          },
          "cityId": {
            "type": "string"
          },
          "coverKey": {
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "endsAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "isDemo": {
            "type": "boolean"
          },
          "publishedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "published",
              "cancelled",
              "completed"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "venueAddress": {
            "type": "string"
          },
          "venueName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "coverKey",
          "venueName",
          "venueAddress",
          "cityId",
          "startsAt",
          "endsAt",
          "capacity",
          "status",
          "isDemo",
          "createdAt",
          "publishedAt",
          "updatedAt",
          "cancelledAt",
          "attendeesRounded"
        ],
        "type": "object"
      },
      "OperatorEmailDto": {
        "properties": {
          "email": {
            "example": "operatore@example.invalid",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "OperatorMeDto": {
        "properties": {
          "id": {
            "type": "string"
          },
          "lastTotpAt": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "admin",
                "moderator",
                "support"
              ],
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "roles",
          "lastTotpAt"
        ],
        "type": "object"
      },
      "OperatorSessionDto": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "token": {
            "description": "Token della sessione, da inviare nell'intestazione `X-Operator-Token`",
            "type": "string"
          }
        },
        "required": [
          "token",
          "expiresAt"
        ],
        "type": "object"
      },
      "OperatorVerifyDto": {
        "properties": {
          "code": {
            "description": "Codice OTP ricevuto via email",
            "example": "123456",
            "type": "string"
          },
          "email": {
            "example": "operatore@example.invalid",
            "type": "string"
          },
          "totp": {
            "description": "Codice TOTP dell'app di autenticazione (D88)",
            "example": "654321",
            "type": "string"
          }
        },
        "required": [
          "email",
          "code",
          "totp"
        ],
        "type": "object"
      },
      "PreviousAttemptDto": {
        "properties": {
          "attempt": {
            "type": "number"
          },
          "explanation": {
            "nullable": true,
            "type": "string"
          },
          "reason": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "attempt",
          "reason",
          "explanation"
        ],
        "type": "object"
      },
      "QueueItemDto": {
        "properties": {
          "ageYears": {
            "description": "Solo l'età, mai la data di nascita (D90)",
            "type": "number"
          },
          "attempt": {
            "maximum": 3,
            "minimum": 1,
            "type": "number"
          },
          "bio": {
            "nullable": true,
            "type": "string"
          },
          "companyName": {
            "nullable": true,
            "type": "string"
          },
          "dueAt": {
            "format": "date-time",
            "type": "string"
          },
          "firstName": {
            "nullable": true,
            "type": "string"
          },
          "gender": {
            "nullable": true,
            "type": "string"
          },
          "lookingFor": {
            "nullable": true,
            "type": "string"
          },
          "minutesLeft": {
            "description": "Minuti alle 24 ore, negativi se in ritardo (D144)",
            "type": "number"
          },
          "practiceArea": {
            "nullable": true,
            "type": "string"
          },
          "reviewId": {
            "type": "string"
          },
          "submittedAt": {
            "format": "date-time",
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "reviewId",
          "userId",
          "attempt",
          "submittedAt",
          "dueAt",
          "minutesLeft",
          "firstName",
          "ageYears",
          "gender",
          "practiceArea",
          "lookingFor",
          "bio",
          "companyName"
        ],
        "type": "object"
      },
      "RejectDto": {
        "properties": {
          "explanation": {
            "example": "Nuova società di consulenza approvata dal team",
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          },
          "reason": {
            "enum": [
              "inappropriate_photos",
              "photos_without_person",
              "fake_profile",
              "text_not_allowed",
              "reveals_company_or_clients",
              "other"
            ],
            "type": "string"
          },
          "userExplanation": {
            "description": "Cosa correggere: visibile solo nell'app (D142)",
            "maxLength": 1000,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "explanation",
          "reason",
          "userExplanation"
        ],
        "type": "object"
      },
      "RejectResultDto": {
        "properties": {
          "attempt": {
            "type": "number"
          },
          "blocked": {
            "description": "Terzo rifiuto: email bloccate per 2 anni (D142)",
            "type": "boolean"
          }
        },
        "required": [
          "attempt",
          "blocked"
        ],
        "type": "object"
      },
      "RenameCompanyDto": {
        "properties": {
          "explanation": {
            "example": "Nuova società di consulenza approvata dal team",
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "type": "string"
          }
        },
        "required": [
          "explanation",
          "name"
        ],
        "type": "object"
      },
      "ReviewDetailDto": {
        "properties": {
          "ageYears": {
            "description": "Solo l'età, mai la data di nascita (D90)",
            "type": "number"
          },
          "attempt": {
            "maximum": 3,
            "minimum": 1,
            "type": "number"
          },
          "bio": {
            "nullable": true,
            "type": "string"
          },
          "companyName": {
            "nullable": true,
            "type": "string"
          },
          "dueAt": {
            "format": "date-time",
            "type": "string"
          },
          "firstName": {
            "nullable": true,
            "type": "string"
          },
          "gender": {
            "nullable": true,
            "type": "string"
          },
          "lookingFor": {
            "nullable": true,
            "type": "string"
          },
          "minutesLeft": {
            "description": "Minuti alle 24 ore, negativi se in ritardo (D144)",
            "type": "number"
          },
          "outcome": {
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "type": "string"
          },
          "photos": {
            "items": {
              "$ref": "#/components/schemas/ReviewPhotoDto"
            },
            "type": "array"
          },
          "practiceArea": {
            "nullable": true,
            "type": "string"
          },
          "previousAttempts": {
            "items": {
              "$ref": "#/components/schemas/PreviousAttemptDto"
            },
            "type": "array"
          },
          "reviewId": {
            "type": "string"
          },
          "submittedAt": {
            "format": "date-time",
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "reviewId",
          "userId",
          "attempt",
          "submittedAt",
          "dueAt",
          "minutesLeft",
          "firstName",
          "ageYears",
          "gender",
          "practiceArea",
          "lookingFor",
          "bio",
          "companyName",
          "outcome",
          "photos",
          "previousAttempts"
        ],
        "type": "object"
      },
      "ReviewPhotoDto": {
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "type": "number"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "position",
          "status"
        ],
        "type": "object"
      },
      "StrongConfirmationDto": {
        "properties": {
          "confirmName": {
            "description": "Nome dell'oggetto digitato per conferma",
            "type": "string"
          },
          "explanation": {
            "example": "Nuova società di consulenza approvata dal team",
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          },
          "totp": {
            "example": "123456",
            "type": "string"
          }
        },
        "required": [
          "explanation",
          "confirmName",
          "totp"
        ],
        "type": "object"
      },
      "UpdateOffsiteDto": {
        "properties": {
          "capacity": {
            "minimum": 1,
            "nullable": true,
            "type": "object"
          },
          "cityId": {
            "example": "015146",
            "type": "string"
          },
          "description": {
            "maxLength": 4000,
            "type": "string"
          },
          "endsAt": {
            "format": "date-time",
            "type": "string"
          },
          "explanation": {
            "maxLength": 500,
            "minLength": 3,
            "type": "string"
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "type": "string"
          },
          "venueAddress": {
            "maxLength": 240,
            "type": "string"
          },
          "venueName": {
            "maxLength": 120,
            "type": "string"
          }
        },
        "required": [
          "explanation"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "operator": {
        "in": "header",
        "name": "X-Operator-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "Swipe & Slide — API di amministrazione",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/backoffice/approvals/{id}": {
      "get": {
        "operationId": "ApprovalsController_detail",
        "parameters": [
          {
            "in": "header",
            "name": "X-Operator-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewDetailDto"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "backoffice-approvals"
        ]
      }
    },
    "/backoffice/approvals/{id}/approval": {
      "post": {
        "operationId": "ApprovalsController_approve",
        "parameters": [
          {
            "in": "header",
            "name": "X-Operator-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplanationDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "tags": [
          "backoffice-approvals"
        ]
      }
    },
    "/backoffice/approvals/{id}/rejection": {
      "post": {
        "operationId": "ApprovalsController_reject",
        "parameters": [
          {
            "in": "header",
            "name": "X-Operator-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RejectResultDto"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "backoffice-approvals"
        ]
      }
    },
    "/backoffice/approvals/queue": {
      "get": {
        "operationId": "ApprovalsController_queue",
        "parameters": [
          {
            "in": "header",
            "name": "X-Operator-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Cursore: `submittedAt` dell'ultima revisione della pagina",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QueueItemDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "backoffice-approvals"
        ]
      }
    },
