# Variabili d'ambiente del backoffice: solo le chiavi, nessun valore segreto.
# Copia in .env.local per lo sviluppo; in produzione i valori vengono da Secret Manager.

# Adattatore delle API di amministrazione: mock (dati in memoria, di base) oppure http.
ADMIN_API_ADAPTER=
# URL di admin-api (obbligatoria con http), per esempio il servizio Cloud Run privato.
ADMIN_API_URL=
# true su Cloud Run: il chiamante si presenta ad admin-api con il token d'identità del suo account
# di servizio (server dei metadati).
ADMIN_API_IAM=

# Chiave dei cookie cifrati, 32 byte in base64 (openssl rand -base64 32). Obbligatoria in
# produzione; in sviluppo, se manca, se ne crea una casuale e le sessioni finiscono al riavvio.
SESSION_SECRET=
# Cookie Secure e prefisso __Host-: di base attivi in produzione e spenti in sviluppo.
COOKIE_SECURE=

# Origine delle foto in revisione (URL firmati dell'archivio), aggiunta alla CSP img-src.
ADMIN_PHOTOS_ORIGIN=

# Solo adattatore mock. Codice all'email fisso (altrimenti casuale e stampato sulla console del
# server). Il secondo fattore degli operatori finti si legge con: npm run mock:totp
# Operatori finti: admin@swipeandslide.example, moderatore@swipeandslide.example,
# supporto@swipeandslide.example
MOCK_SIGN_IN_CODE=
# Solo per provare la build di produzione in locale con i dati finti (npm run build && npm start).
ALLOW_MOCK_IN_PRODUCTION=
